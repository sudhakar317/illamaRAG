# Copy to server/.env and edit as needed. All values are optional --
# the defaults in app/config.py are already correct for this machine.

# Absolute path to the GGUF chat model.
# Default: <repo>/models/Qwen3.5-4B-Q4_K_M.gguf
# MODEL_PATH=C:/Users/91908/Desktop/sudhakar.s/illamaProjects/models/Qwen3.5-4B-Q4_K_M.gguf

# Context window in tokens. Raising this grows the KV cache and RAM use.
# N_CTX=4096

# Physical CPU cores.
# N_THREADS=4

# Let the model emit <think>...</think> reasoning. Slow on CPU; off by default.
# ENABLE_THINKING=false

# Tokens reserved for the reply.
# MAX_OUTPUT_TOKENS=1024
